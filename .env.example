# ════════════════════════════════════════════════════════════════
#  REQUIRED
# ════════════════════════════════════════════════════════════════

# ── GROQ (free at console.groq.com) — caption/content generation ──
GROQ_API_KEY=your_groq_api_key_here

# ── INSTAGRAM PRIVATE API (the active poster) ─────────────────────
# Get these by running:  node get-session.js   (logs in once, saves the session)
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
IG_SESSION_ID=your_session_id_here

# ════════════════════════════════════════════════════════════════
#  IMAGES — works with ZERO keys (free Wikimedia Commons + Openverse
#  photos, branded automatically). Add any key below to upgrade to
#  AI-generated art (tried first; falls back to free photos).
# ════════════════════════════════════════════════════════════════
HF_API_KEY=                 # huggingface.co/settings/tokens (FLUX)
TOGETHER_API_KEY=           # api.together.xyz (free FLUX.1-schnell)
FAL_KEY=                    # fal.ai (free credits on signup)
STABILITY_API_KEY=          # platform.stability.ai
PEXELS_API_KEY=             # pexels.com/api (free stock photos)
PIXABAY_API_KEY=            # pixabay.com/api/docs (free stock photos)

# Branding shown on every generated image
BRAND_NAME=TamilNadu Unfiltered

# ════════════════════════════════════════════════════════════════
#  OPTIONAL — official Instagram Graph API (auto-falls back to
#  private API if the token is expired/blocked)
# ════════════════════════════════════════════════════════════════
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IMGBB_API_KEY=              # free image hosting for Graph API (imgbb.com/api)
FB_APP_ID=
FB_APP_SECRET=
RENDER_API_KEY=            # auto-update env vars on Render after token refresh

# ── SERVER ────────────────────────────────────────────────────────
PORT=3000
